	column 'Is Last 4 Quarters' = VAR MaxDate = CALCULATE(MAX('500000 Sales Records'[Order Date]), ALL('500000 Sales Records')) VAR MaxQuarterStart = DATE(YEAR(MaxDate), (ROUNDUP(MONTH(MaxDate)/3,0)-1)*3+1, 1) VAR CutoffDate = EDATE(MaxQuarterStart, -9) RETURN IF('Date_Order_date_Full'[Date] >= CutoffDate, 1, 0)
		formatString: 0
		lineageTag: 625fcb33-ec42-488d-9648-ee908873cf1f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Is Last 5 Years' = ```
			
			VAR MaxYr = CALCULATE(YEAR(MAX('500000 Sales Records'[Order Date])), ALL('500000 Sales Records'))
			RETURN 
			IF('Date_Order_date_Full'[Year] >= MaxYr - 4 && 'Date_Order_date_Full'[Year] <= MaxYr, 1, 0)
			```
		formatString: 0
		lineageTag: d0f98bcf-45a2-4842-b55d-7f568ceabbe8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition Date_Order_date_Full = calculated
		mode: import
		source =
				
				VAR MinYear = YEAR(MIN('500000 Sales Records'[Order Date]))
				VAR MaxYear = YEAR(MAX('500000 Sales Records'[Order Date]))
				RETURN
				ADDCOLUMNS(
				    CALENDAR(DATE(MinYear, 1, 1), DATE(MaxYear, 12, 31)),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Year-Month", FORMAT([Date], "MMM YYYY"),
				    "Year-Quarter", FORMAT([Date], "YYYY") & " Q" & FORMAT([Date], "Q")
				)

	annotation PBI_Id = 3b93b0477476414cb7daeab6216b4287

